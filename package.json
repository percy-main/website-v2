{
  "name": "percy-main",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "dev": "bash scripts/dev.sh",
    "dev:api": "pnpm --filter api dev",
    "dev:web": "pnpm --filter web dev",
    "dev:email": "pnpm --filter email-viewer dev",
    "build": "pnpm -r run build",
    "build:api": "pnpm --filter api build",
    "build:web": "pnpm --filter web build",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "lint": "pnpm -r run lint",
    "test": "pnpm -r run test",
    "typecheck": "pnpm -r run typecheck",
    "db:up": "pnpm --filter @percy-main/db db:up",
    "db:types": "pnpm --filter @percy-main/db db:types",
    "db:migration": "pnpm --filter @percy-main/db db:migration",
    "db:reset": "pnpm --filter @percy-main/db db:reset",
    "db:lift": "pnpm --filter @percy-main/db db:lift",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "openapi:generate": "pnpm --filter api exec tsx src/generate-openapi.ts > apps/web/src/lib/api.gen.json && pnpm exec openapi-typescript apps/web/src/lib/api.gen.json -o apps/web/src/lib/api.gen.d.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10",
    "eslint": "^10",
    "eslint-plugin-react-hooks": "^7.0.1",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.8.1",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "react-doctor": "^0.1.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.0"
  }
}
