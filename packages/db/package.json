{
  "name": "@percy-main/db",
  "version": "0.0.1",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsc",
    "db:up": "tsx ./scripts/migrate-up.ts",
    "db:types": "kysely-codegen --out-file ./src/__generated__/db.ts",
    "db:migration": "tsx ./scripts/create-migration.ts",
    "db:reset": "tsx ./scripts/reset-local.ts",
    "db:lift": "tsx ./scripts/data-lift.ts",
    "db:setup-scout": "tsx ./scripts/setup-scout-readonly.ts",
    "db:setup-app-roles": "tsx ./scripts/setup-app-roles.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/"
  },
  "dependencies": {
    "@percy-main/shared": "workspace:*",
    "date-fns": "^4.4.0",
    "kysely": "^0.29.2",
    "pg": "^8.21.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@libsql/client": "^0.17.3",
    "@types/node": "^25.9.1",
    "@types/pg": "^8.20.0",
    "dotenv": "^17.4.2",
    "kysely-codegen": "^0.20.0",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3"
  }
}
