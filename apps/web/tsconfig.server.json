{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "paths": {
      "@/*": ["./src/*"]
    },
    "noEmit": true,
    "types": ["node", "google.maps"],
    // See tsconfig.json — same TS2883 fix, needed here too since this
    // config also type-checks src/**/* (including auth-client.ts).
    "declaration": false,
    "declarationMap": false
  },
  "include": ["server/**/*", "src/**/*"]
}
