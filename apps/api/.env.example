# Database
DATABASE_URL=postgres://percy:percy@localhost:5433/percy_main

# Auth
BETTER_AUTH_SECRET=your-secret-here
BETTER_AUTH_RP_ID=localhost
BETTER_AUTH_RP_NAME=Percy Main CSC
BASE_URL=http://localhost:5173
API_BASE_URL=http://localhost:3000
# The matchday PWA's dev URL. Must be set so its origin is in
# better-auth's trustedOrigins - without it the matchday app reads
# session as null after a login redirect even though the cookie is set.
MATCHDAY_URL=http://localhost:5175
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Better Auth Dash (infra plugin — optional, enables better-auth dashboard)
BETTER_AUTH_API_KEY=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Email (SES in production, dev mode writes to .emails/)
EMAIL_PROVIDER=dev
SES_REGION=eu-west-2
SES_FROM_ADDRESS=Percy Main CSC Support <support@notifications.percymain.org>

# S3 (receipt uploads — optional in dev, required in production)
# For local dev with LocalStack: docker compose up -d
S3_BUCKET=percy-main-receipts-local
S3_REGION=eu-west-2
S3_RECEIPT_PREFIX=receipts
S3_ENDPOINT=http://localhost:4566

# S3 (policy documents — for verified document viewing)
S3_DOCUMENTS_BUCKET=percy-main-documents-local
S3_DOCUMENTS_PREFIX=documents
S3_DOCUMENT_UPLOADS_BUCKET=percy-main-document-uploads-local

# S3 (Scout-generated PDF reports)
SCOUT_REPORTS_BUCKET=percy-main-scout-reports-local
SCOUT_REPORTS_PREFIX=reports

# S3 (Scout chat attachments — image / PDF originals + browser uploads)
SCOUT_ATTACHMENT_UPLOADS_BUCKET=percy-main-scout-attachment-uploads-local
SCOUT_ATTACHMENTS_BUCKET=percy-main-scout-attachments-local
SCOUT_ATTACHMENTS_PREFIX=scout/attachments
# Per-attachment size caps (bytes). Defaults: 10 MB image / 10 MB PDF.
# SCOUT_ATTACHMENT_MAX_IMAGE_BYTES=10485760
# SCOUT_ATTACHMENT_MAX_PDF_BYTES=10485760
# Haiku output cap + sanity bound on derived text length.
# SCOUT_ATTACHMENT_DERIVE_MAX_TOKENS=1500
# SCOUT_ATTACHMENT_DERIVED_TEXT_MAX_BYTES=256000
# Image / PDF derive is Anthropic-only regardless of SCOUT_PROVIDER_CHAT.
# Override the default Haiku id if a newer model lands.
# SCOUT_ATTACHMENT_DERIVE_MODEL=claude-haiku-4-5-20251001

# S3 (Scout knowledge base — admin-uploaded reference docs)
SCOUT_KB_UPLOADS_BUCKET=percy-main-scout-kb-uploads-local
SCOUT_KB_BUCKET=percy-main-scout-kb-local
SCOUT_KB_PREFIX=scout/knowledge
# Per-document size cap (bytes). Default: 25 MB.
# SCOUT_KB_MAX_DOCUMENT_BYTES=26214400
# Chunking knobs — tune after benching retrieval quality on a few docs.
# SCOUT_KB_CHUNK_TARGET_TOKENS=600
# SCOUT_KB_CHUNK_OVERLAP_TOKENS=100
# SCOUT_KB_EMBED_BATCH_SIZE=64
# SCOUT_KB_UPLOAD_URL_EXPIRY_SECONDS=900

# Observability (New Relic via OpenTelemetry — optional in dev)
# When NEW_RELIC_LICENSE_KEY is not set, instrumentation is disabled
NEW_RELIC_LICENSE_KEY=
OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp.eu01.nr-data.net
OTEL_SERVICE_NAME=percy-main-api

# Arize Phoenix LLM tracing (required).
# Paste PHOENIX_COLLECTOR_ENDPOINT verbatim from the Phoenix Cloud
# space settings page - the bare host/space URL (no /v1/traces suffix).
# Self-hosted Phoenix: http://localhost:6006
# AI SDK calls use this isolated tracer; spans never reach New Relic.
PHOENIX_API_KEY=phx-placeholder
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006
PHOENIX_PROJECT_NAME=percy-main-scout

# Web Push (VAPID) — required. Generate a keypair with:
#   npx web-push generate-vapid-keys
# The same keypair must be used across deploys; rotating it forces every
# subscribed device to re-subscribe.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@notifications.percymain.org

# External services
SLACK_WEBHOOK_URL=
PLAY_CRICKET_API_TOKEN=
PLAY_CRICKET_SITE_ID=

# Scout (AI analyst — alex-only)
# Run `pnpm --filter @percy-main/db db:setup-scout` to create the local
# scout_readonly user and emit SCOUT_DB_URL.
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
# Provider + model id for each Scout LLM surface. All required;
# there are no in-code defaults. Set the same env vars in the AWS
# task definition for staging / production. The DB tools (db_run_sql
# etc.) are wired straight into the chat and report agents and run no
# LLM of their own, so there is no separate DB provider/model.
SCOUT_PROVIDER_CHAT=deepseek
SCOUT_MODEL_CHAT=deepseek-v4-pro
# Thread-title generator (a short one-shot LLM call).
SCOUT_PROVIDER_SUBAGENT=deepseek
SCOUT_MODEL_SUBAGENT=deepseek-v4-pro
# Report agent (the background loop behind generate_report).
SCOUT_PROVIDER_REPORT=deepseek
SCOUT_MODEL_REPORT=deepseek-v4-flash
# Image / PDF input is Anthropic-only regardless of SCOUT_PROVIDER_CHAT.
# Used by chat-attachment derive AND KB image captioning + PDF extract.
SCOUT_ATTACHMENT_DERIVE_MODEL=claude-haiku-4-5-20251001
# Voyage models — must match what's been used to embed scout_fact and
# scout_kb_chunk rows historically. Changing these without a re-embed
# is a recall regression.
VOYAGE_EMBED_MODEL=voyage-4
VOYAGE_RERANK_MODEL=rerank-2.5
# Tavily — backs Scout's recognition-source discovery tool. See ADR 042.
TAVILY_API_KEY=
SCOUT_DB_URL=
