{
  "name": "api",
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false --import ./src/instrumentation.ts --env-file=.env src/server.ts",
    "build": "tsc",
    "start": "node --import ./dist/instrumentation.js dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:all": "pnpm test && pnpm test:integration",
    "openapi": "tsx src/generate-openapi.ts > ../web/src/lib/api.gen.json && pnpm exec openapi-typescript ../web/src/lib/api.gen.json -o ../web/src/lib/api.gen.d.ts && cp ../web/src/lib/api.gen.json ../matchday/src/lib/api.gen.json && pnpm exec openapi-typescript ../matchday/src/lib/api.gen.json -o ../matchday/src/lib/api.gen.d.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "3.0.74",
    "@ai-sdk/deepseek": "^2.0.32",
    "@arizeai/openinference-semantic-conventions": "^2.3.0",
    "@arizeai/openinference-vercel": "^2.7.4",
    "@aws-sdk/client-ecs": "^3.1022.0",
    "@aws-sdk/client-rekognition": "^3.1022.0",
    "@aws-sdk/client-s3": "^3.1022.0",
    "@aws-sdk/s3-request-presigner": "^3.1022.0",
    "@better-auth/infra": "^0.1.13",
    "@better-auth/passkey": "^1.5.4",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.0.0",
    "@fastify/otel": "^0.18.1",
    "@fastify/swagger": "^9.7.0",
    "@fastify/swagger-ui": "^5.2.5",
    "@napi-rs/canvas": "^0.1.100",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.76.0",
    "@opentelemetry/context-async-hooks": "^2.7.1",
    "@opentelemetry/exporter-logs-otlp-proto": "^0.218.0",
    "@opentelemetry/exporter-metrics-otlp-proto": "^0.218.0",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.218.0",
    "@opentelemetry/resources": "^2.7.1",
    "@opentelemetry/sdk-logs": "^0.218.0",
    "@opentelemetry/sdk-metrics": "^2.7.1",
    "@opentelemetry/sdk-node": "^0.218.0",
    "@opentelemetry/sdk-trace-node": "^2.7.1",
    "@opentelemetry/semantic-conventions": "^1.41.1",
    "@percy-main/db": "workspace:*",
    "@percy-main/email": "workspace:*",
    "@percy-main/shared": "workspace:*",
    "@react-pdf/renderer": "^4.5.1",
    "@simplewebauthn/server": "^13.3.0",
    "ai": "6.0.174",
    "better-auth": "^1.5.4",
    "better-call": "1.3.2",
    "chart.js": "^4.5.1",
    "date-fns": "^4.1.0",
    "fastify": "^5.8.5",
    "fastify-type-provider-zod": "^6.1.0",
    "google-ads-api": "23.0.0",
    "kysely": "^0.28.17",
    "openapi-types": "^12.1.3",
    "opentype.js": "^1.3.4",
    "pg": "^8.13.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-email": "^6.1.4",
    "sharp": "^0.34.5",
    "stripe": "^17.5.0",
    "ts-pattern": "^5.6.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^11.14.0",
    "@types/node": "^25.9.0",
    "@types/opentype.js": "^1.3.9",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@types/supertest": "^7.2.0",
    "@vitest/coverage-v8": "^4.1.6",
    "dotenv": "^17.4.2",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.2.2",
    "testcontainers": "^11.14.0",
    "tsx": "^4.22.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.6"
  }
}
